{
  "datasets": [
    {
      "name": "f2026c14",
      "displayName": "kpis",
      "queryLines": [
        "select\n",
        "    count(*)                                                        as sellers,\n",
        "    sum(case when is_active_90d then 1 else 0 end)                  as active_sellers,\n",
        "    round(avg(case when is_active_90d then 1.0 else 0.0 end), 3)    as activation_rate,\n",
        "    round(percentile(case when is_active_90d then revenue_90d end, 0.5), 2) as median_revenue_active\n",
        "from workspace.marts.fact_seller_channel_performance"
      ]
    },
    {
      "name": "9122c946",
      "displayName": "channel_activation",
      "queryLines": [
        "with base as (\n",
        "    select\n",
        "        channel_group,\n",
        "        count(*)                                       as sellers,\n",
        "        sum(case when is_active_90d then 1 else 0 end) as active\n",
        "    from workspace.marts.fact_seller_channel_performance\n",
        "    group by channel_group\n",
        "),\n",
        "\n",
        "calc as (\n",
        "    select *, active / sellers as p, 1.96 as z\n",
        "    from base\n",
        ")\n",
        "\n",
        "select\n",
        "    channel_group,\n",
        "    sellers,\n",
        "    active,\n",
        "    round(p, 3) as activation_rate,\n",
        "    round((p + z*z/(2*sellers) - z*sqrt(p*(1-p)/sellers + z*z/(4*sellers*sellers))) / (1 + z*z/sellers), 3) as ci_low,\n",
        "    round((p + z*z/(2*sellers) + z*sqrt(p*(1-p)/sellers + z*z/(4*sellers*sellers))) / (1 + z*z/sellers), 3) as ci_high\n",
        "from calc\n",
        "order by activation_rate desc"
      ]
    },
    {
      "name": "d2d593f4",
      "displayName": "lead_type_activation",
      "queryLines": [
        "with base as (\n",
        "    select\n",
        "        coalesce(lead_type, 'unknown')                 as lead_type,\n",
        "        count(*)                                       as sellers,\n",
        "        sum(case when is_active_90d then 1 else 0 end) as active\n",
        "    from workspace.marts.fact_seller_channel_performance\n",
        "    group by 1\n",
        "    having count(*) >= 20\n",
        "),\n",
        "\n",
        "calc as (\n",
        "    select *, active / sellers as p, 1.96 as z\n",
        "    from base\n",
        ")\n",
        "\n",
        "select\n",
        "    lead_type,\n",
        "    sellers,\n",
        "    round(p, 3) as activation_rate,\n",
        "    round((p + z*z/(2*sellers) - z*sqrt(p*(1-p)/sellers + z*z/(4*sellers*sellers))) / (1 + z*z/sellers), 3) as ci_low,\n",
        "    round((p + z*z/(2*sellers) + z*sqrt(p*(1-p)/sellers + z*z/(4*sellers*sellers))) / (1 + z*z/sellers), 3) as ci_high\n",
        "from calc\n",
        "order by activation_rate desc"
      ]
    },
    {
      "name": "28072d23",
      "displayName": "business_type_activation",
      "queryLines": [
        "with base as (\n",
        "    select\n",
        "        coalesce(business_type, 'unknown')             as business_type,\n",
        "        count(*)                                       as sellers,\n",
        "        sum(case when is_active_90d then 1 else 0 end) as active\n",
        "    from workspace.marts.fact_seller_channel_performance\n",
        "    group by 1\n",
        "    having count(*) >= 20\n",
        "),\n",
        "\n",
        "calc as (\n",
        "    select *, active / sellers as p, 1.96 as z\n",
        "    from base\n",
        ")\n",
        "\n",
        "select\n",
        "    business_type,\n",
        "    sellers,\n",
        "    round(p, 3) as activation_rate,\n",
        "    round((p + z*z/(2*sellers) - z*sqrt(p*(1-p)/sellers + z*z/(4*sellers*sellers))) / (1 + z*z/sellers), 3) as ci_low,\n",
        "    round((p + z*z/(2*sellers) + z*sqrt(p*(1-p)/sellers + z*z/(4*sellers*sellers))) / (1 + z*z/sellers), 3) as ci_high\n",
        "from calc\n",
        "order by activation_rate desc"
      ]
    },
    {
      "name": "f83149f2",
      "displayName": "revenue_by_channel",
      "queryLines": [
        "select\n",
        "    channel_group,\n",
        "    count(*)                                 as active_sellers,\n",
        "    round(percentile(revenue_90d, 0.5), 2)   as median_revenue,\n",
        "    round(avg(revenue_90d), 2)               as mean_revenue\n",
        "from workspace.marts.fact_seller_channel_performance\n",
        "where is_active_90d\n",
        "group by channel_group\n",
        "order by median_revenue desc"
      ]
    },
    {
      "name": "d7fb643b",
      "displayName": "break_even",
      "queryLines": [
        "with rates as (\n",
        "    select\n",
        "        avg(case when channel_group = 'paid_search'\n",
        "                 then case when is_active_90d then 1.0 else 0.0 end end)    as paid_rate,\n",
        "        avg(case when channel_group = 'organic_search'\n",
        "                 then case when is_active_90d then 1.0 else 0.0 end end)    as organic_rate\n",
        "    from workspace.marts.fact_seller_channel_performance\n",
        "),\n",
        "\n",
        "premiums as (\n",
        "    select explode(array(0.0, 0.2, 0.4, 0.6, 0.8)) as premium\n",
        ")\n",
        "\n",
        "select\n",
        "    concat(cast(round(premium * 100) as int), '%')             as paid_cost_premium,\n",
        "    round((1 + premium) / (paid_rate / organic_rate), 2)       as paid_cost_per_active_vs_organic,\n",
        "    case when (1 + premium) / (paid_rate / organic_rate) < 1\n",
        "         then 'Paid search cheaper' else 'Organic cheaper' end as verdict\n",
        "from rates\n",
        "cross join premiums\n",
        "order by premium"
      ]
    }
  ],
